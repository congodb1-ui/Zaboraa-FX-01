# ==============================================================================
# Zaboraa FX Environment Configuration (.env.example)
# Copy this file to .env and configure the parameters for your local environment.
# ==============================================================================

# Server Network Configuration
PORT=3000                                # Optional (default: 3000) - HTTP web server port
HOST=127.0.0.1                           # Optional (default: 127.0.0.1) - Localhost binding for security

# Gemini AI Configuration
GEMINI_API_KEY=                          # Required - Google AI Studio API key for Pine Script translation
GEMINI_MODEL=gemini-3.8-flash            # Optional (default: gemini-3.8-flash) - Model for code conversion

# Security & Encryption
ENCRYPTION_MASTER_KEY=                   # Required for live trading/tokens - 32-byte secret (e.g. openssl rand -hex 32)
ALLOW_LIVE=false                         # Optional (default: false) - Master safety gate for live trading orders

# MetaTrader 5 Bridge Connection
BRIDGE_URL=http://127.0.0.1:8001         # Required for MT5 integration - Local bridge URL
BRIDGE_TOKEN=                            # Required - Secret bearer token shared with bridge (min 24 characters)
ALLOW_TRADING=false                      # Optional (default: false) - Bridge trade execution permission gate

# Strategy QuickJS Sandbox Limits
SANDBOX_MEMORY_MB=128                    # Optional (default: 128) - QuickJS sandbox memory ceiling in MB
SANDBOX_BAR_TIMEOUT_MS=50                # Optional (default: 50) - Per-bar strategy execution timeout in ms

# Fundamental Data Module (Stage 5)
FRED_API_KEY=                            # Optional until Stage 5 - Federal Reserve Economic Data API key

# MetaTrader 5 Account Credentials (read by mt5-bridge on Windows)
MT5_LOGIN=                               # Optional (or set in mt5-bridge/.env) - Broker account number
MT5_PASSWORD=                            # Optional (or set in mt5-bridge/.env) - Broker account password
MT5_SERVER=                              # Optional (or set in mt5-bridge/.env) - Broker server name