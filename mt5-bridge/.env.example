# Zaboraa FX - Exness MetaTrader 5 Bridge Configuration
# Binds strictly to 127.0.0.1 on Windows

# Shared secret bearer token required on every HTTP & WebSocket request
BRIDGE_TOKEN="zaboraa_local_bridge_token_9872"

# Bridge Server Host and Port
HOST="127.0.0.1"
PORT=8001

# Read-only Safety Lock
# While false, /orders and modify/close endpoints return HTTP 403 Forbidden
ALLOW_TRADING=false

# Exness MT5 Account Credentials (Demo Safe Placeholders)
MT5_LOGIN=50192834
MT5_PASSWORD="demo_password"
MT5_SERVER="Exness-MT5Trial9"

# Optional path to MetaTrader 5 terminal64.exe if installed in a custom directory
# MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
